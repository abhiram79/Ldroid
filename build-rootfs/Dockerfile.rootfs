# build-rootfs/Dockerfile.rootfs

# ── Stage 1: build the LDroid guest helpers (static aarch64) ───────────────
# The guest runs Debian/glibc. The helpers are linked statically so they keep
# working if the user upgrades libc through the persistent overlay.
FROM --platform=linux/arm64 debian:bookworm AS helper-builder
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential make libc6-dev linux-libc-dev ca-certificates \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /work
COPY vsock-agent /work/vsock-agent
RUN cd /work/vsock-agent && make CC=gcc
COPY host-bridge /work/host-bridge
RUN cd /work/host-bridge && make CC=gcc
COPY overlay-normalize /work/overlay-normalize
RUN cd /work/overlay-normalize && make CC=gcc

# ── Stage 2: build the Debian (bookworm) rootfs squashfs ───────────────────
FROM --platform=linux/arm64 debian:bookworm AS builder

ARG DEBIAN_RELEASE=bookworm
ARG DEBIAN_ARCH=arm64

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        debootstrap squashfs-tools zstd xz-utils openssl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /work

# debootstrap installs the complete Debian userland in one pass. Running the
# builder as linux/arm64 means the second stage executes natively under QEMU
# instead of needing qemu-aarch64-static inside a foreign-arch rootfs.
RUN debootstrap --variant=minbase --arch="${DEBIAN_ARCH}" \
        --include=systemd,systemd-sysv,libpam-systemd,dbus,apt-utils,apt-transport-https,bash,ca-certificates,coreutils,curl,e2fsprogs,hostname,iproute2,iputils-ping,isc-dhcp-client,kmod,less,procps,psmisc,util-linux,openssl,gzip,xz-utils,zstd,dropbear,openssh-sftp-server,tigervnc-standalone-server,tigervnc-common,pulseaudio,pulseaudio-utils,fonts-dejavu-core,xfonts-base,busybox-static,adduser \
        "${DEBIAN_RELEASE}" /work/rootfs "http://deb.debian.org/debian"

# Pull in the static helpers built in stage 1.
RUN mkdir -p /work/rootfs/usr/local/bin
COPY --from=helper-builder /work/vsock-agent/ldroid-vsock-agent /work/rootfs/usr/local/bin/ldroid-vsock-agent
COPY --from=helper-builder /work/host-bridge/ldroid-hostd /work/rootfs/usr/local/bin/ldroid-hostd
COPY --from=helper-builder /work/overlay-normalize/ldroid-overlay-normalize /work/rootfs/usr/local/bin/ldroid-overlay-normalize

ARG SYSTEM_VERSION=0
ENV SYSTEM_VERSION=${SYSTEM_VERSION}

ENV DEBIAN_VERSION=${DEBIAN_RELEASE}
ENV DEBIAN_ARCH=${DEBIAN_ARCH}
COPY files /work/files
# Staged by build_rootfs() in build-all.sh (docs/ lives outside this build
# context); served in-guest by /usr/local/bin/ldroid-docs.
COPY docs-guide /work/docs-guide
COPY build-rootfs.sh /work/build-rootfs.sh
RUN chmod +x /work/build-rootfs.sh && /work/build-rootfs.sh

RUN mksquashfs /work/rootfs /work/debian-rootfs.squashfs \
    -comp zstd -Xcompression-level 19 -all-root -noappend

FROM scratch AS export
COPY --from=builder /work/debian-rootfs.squashfs /debian-rootfs.squashfs
