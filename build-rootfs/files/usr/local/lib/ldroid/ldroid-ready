#!/bin/sh
# LDroid VM ready marker (consumed by the Android boot detector).
#
# ldroid-ready.service orders this after the network, SSH, X11, vsock and
# host-bridge services. It emits the exact stage strings BootStageDetector
# matches, and OOM-protects LDroid's infrastructure processes.
set -u

# A hungry user app (Firefox, Chromium, big npm builds) should be reaped first.
# -1000 makes a process completely immune to OOM. Match by argv[0] basename to
# catch all variants (multiple Xvnc screens, forked dropbear instances per SSH
# session, the agent's listener children).
for _name in dropbear Xtigervnc Xvnc pulseaudio ldroid-vsock-agent; do
    for _pid in $(pgrep -x "$_name" 2>/dev/null); do
        echo -1000 > "/proc/$_pid/oom_score_adj" 2>/dev/null || true
    done
done

echo "Starting SSH..." > /dev/console
echo "Almost ready..." > /dev/console
echo "Ready!" > /dev/console
exit 0
