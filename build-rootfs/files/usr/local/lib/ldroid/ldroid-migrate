#!/bin/sh
# LDroid system migrations: runs versioned upgrade scripts once.
#
# Run early (ldroid-migrate.service, Before=ldroid-bootstrap.service) so a
# migration can prepare state the rest of the boot relies on.
set -u

SYSVER_FILE="/etc/ldroid/system-version"
APPLIED_FILE="/mnt/persist/.ldroid/applied-version"
MIGRATIONS_DIR="/etc/ldroid/migrations"

echo "Running LDroid migrations..." > /dev/console
mkdir -p /mnt/persist/.ldroid

current=$(cat "$SYSVER_FILE" 2>/dev/null || echo 0)
applied=$(cat "$APPLIED_FILE" 2>/dev/null || echo "")

# Fresh install (no marker): seed the marker, run nothing - the squashfs
# already ships the current state.
if [ -z "$applied" ]; then
    printf '%s\n' "$current" > "$APPLIED_FILE.tmp" && mv "$APPLIED_FILE.tmp" "$APPLIED_FILE"
    exit 0
fi

# Fast path / downgrade: nothing to do.
if [ "$current" -le "$applied" ] 2>/dev/null; then
    exit 0
fi

# Run each migrations/<v>.sh with applied < v <= current, in ascending
# numeric order. Scripts MUST be idempotent. Stop at the first failure so the
# failed script and any after it re-run next boot instead of being marked
# applied.
last_ok="$applied"
failed=0
for base in $(ls "$MIGRATIONS_DIR" 2>/dev/null | sed -n 's/\.sh$//p' | sort -n); do
    case "$base" in *[!0-9]*) continue ;; esac
    if [ "$base" -gt "$applied" ] 2>/dev/null && [ "$base" -le "$current" ] 2>/dev/null; then
        echo "ldroid-migrate: applying $base" > /dev/console
        if sh "$MIGRATIONS_DIR/$base.sh" > /dev/console 2>&1; then
            last_ok="$base"
        else
            echo "ldroid-migrate: $base failed, stopping (will retry next boot)" > /dev/console
            failed=1
            break
        fi
    fi
done

# Advance the marker atomically: to current if the loop completed with no
# failure, otherwise to the last successfully applied version.
if [ "$failed" -eq 0 ]; then
    marker="$current"
else
    marker="$last_ok"
fi
printf '%s\n' "$marker" > "$APPLIED_FILE.tmp" && mv "$APPLIED_FILE.tmp" "$APPLIED_FILE"
exit 0
