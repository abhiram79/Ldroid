#!/bin/sh
# LDroid VM networking: QEMU SLIRP static config, or AVF DHCP.
# Called by ldroid-network.service (oneshot).
set -u

# Validate only plain dotted-quad IPv4 literals before they reach resolv.conf.
is_valid_ipv4() {
    case "$1" in
        ''|*[!0-9.]*|.*|*.|*..*) return 1 ;;
    esac
    _old_ifs=$IFS
    IFS=.
    # shellcheck disable=SC2086
    set -- $1
    IFS=$_old_ifs
    [ "$#" -eq 4 ] || return 1
    for _octet in "$@"; do
        case "$_octet" in ''|*[!0-9]*|0[0-9]*) return 1 ;; esac
        [ "$_octet" -le 255 ] 2>/dev/null || return 1
    done
}

# Print the QEMU resolver file. Device resolvers occupy up to two slots in
# their original order; the remaining slots use public fallbacks.
qemu_resolv_conf() {
    _dns_raw=$1
    DEVICE_DNS_1=""
    DEVICE_DNS_2=""

    case "$_dns_raw" in *[!0-9.,]*) _dns_raw="" ;; esac
    if [ -n "$_dns_raw" ]; then
        _old_ifs=$IFS
        IFS=,
        # shellcheck disable=SC2086
        set -- $_dns_raw
        IFS=$_old_ifs
        for _cand in "$@"; do
            is_valid_ipv4 "$_cand" || continue
            case "$_cand" in 127.*|0.0.0.0) continue ;; esac
            [ "$_cand" = "$DEVICE_DNS_1" ] && continue
            [ "$_cand" = "$DEVICE_DNS_2" ] && continue
            if [ -z "$DEVICE_DNS_1" ]; then
                DEVICE_DNS_1=$_cand
            elif [ -z "$DEVICE_DNS_2" ]; then
                DEVICE_DNS_2=$_cand
            fi
        done
    fi

    if [ -z "$DEVICE_DNS_1" ]; then
        printf 'nameserver 10.0.2.3\nnameserver 8.8.8.8\nnameserver 1.1.1.1\n'
        return
    fi

    printf 'nameserver %s\n' "$DEVICE_DNS_1"
    _resolver_count=1
    if [ -n "$DEVICE_DNS_2" ]; then
        printf 'nameserver %s\n' "$DEVICE_DNS_2"
        _resolver_count=2
    fi
    if [ "$_resolver_count" -lt 3 ] &&
        [ "$DEVICE_DNS_1" != "8.8.8.8" ] && [ "$DEVICE_DNS_2" != "8.8.8.8" ]; then
        printf 'nameserver 8.8.8.8\n'
        _resolver_count=$((_resolver_count + 1))
    fi
    if [ "$_resolver_count" -lt 3 ] &&
        [ "$DEVICE_DNS_1" != "1.1.1.1" ] && [ "$DEVICE_DNS_2" != "1.1.1.1" ]; then
        printf 'nameserver 1.1.1.1\n'
    fi
}

main() {
    echo "Configuring network..." > /dev/console
    ip link set lo up 2>/dev/null
    NETIF=""
    for _i in $(seq 1 10); do
        # Exclude virtual/bridge devices so the real virtio NIC is picked.
        NETIF=$(ip -o link show 2>/dev/null | awk -F': ' '{print $2}' | \
            grep -vE '^(lo|dummy[0-9]*|veth|br-)' | head -1)
        [ -n "$NETIF" ] && break
        sleep 0.05
    done
    if [ -z "$NETIF" ]; then
        echo "ERROR: no network interface" > /dev/console
        exit 1
    fi
    ip link set "$NETIF" up

    if grep -q 'ldroid\.backend=avf' /proc/cmdline 2>/dev/null; then
        # AVF backend: crosvm wires the guest to a TAP that Android's tethering
        # manager runs DHCP on. Use Debian's ISC client; its script writes
        # /etc/resolv.conf from the lease.
        timeout 8 dhclient -1 -4 "$NETIF" 2>/dev/null || true
        [ -s /etc/resolv.conf ] || \
            printf 'nameserver 8.8.8.8\nnameserver 1.1.1.1\n' > /etc/resolv.conf
        if ! ip -o -4 addr show dev "$NETIF" 2>/dev/null | grep -q 'inet '; then
            echo "ERROR: DHCP did not assign an address to $NETIF" > /dev/console
            exit 1
        fi
    else
        # QEMU/TCG backend: SLIRP's built-in DHCP also exists but hardcoding
        # is faster and matches every existing user's setup.
        ip addr add 10.0.2.15/24 dev "$NETIF" 2>/dev/null || true
        ip route add default via 10.0.2.2 dev "$NETIF" 2>/dev/null || true
        # SLIRP's 10.0.2.3 DNS forwarder is dead on Android (it reads the
        # host's /etc/resolv.conf, which doesn't exist here). QemuEngine passes
        # the device's own resolvers via ldroid.dns= when it has any.
        DNS_RAW=$(sed -n 's/.*ldroid\.dns=\([0-9.,]*\).*/\1/p' /proc/cmdline 2>/dev/null)
        qemu_resolv_conf "$DNS_RAW" > /etc/resolv.conf
        DNS_SERVERS=$(awk '$1 == "nameserver" { if (dns != "") dns = dns " "; dns = dns $2 } END { print dns }' /etc/resolv.conf)
        echo "DNS: $DNS_SERVERS" > /dev/console
        if ! ip -o -4 addr show dev "$NETIF" 2>/dev/null | grep -q 'inet '; then
            echo "ERROR: static IP did not stick on $NETIF" > /dev/console
            exit 1
        fi
    fi

    BW_MBIT=$(sed -n 's/.*ldroid\.bandwidth=\([0-9]*\).*/\1/p' /proc/cmdline 2>/dev/null)
    if [ -n "$BW_MBIT" ] && [ "$BW_MBIT" -gt 0 ]; then
        tc qdisc replace dev "$NETIF" root tbf rate "${BW_MBIT}mbit" burst 32kbit latency 400ms 2>/dev/null || true
    fi
    echo "Network found" > /dev/console
    exit 0
}

# build-rootfs/tests/test_ldroid_network_dns.sh sources this file to exercise
# qemu_resolv_conf() without touching the host network.
if [ "${LDROID_NETWORK_LIB_ONLY:-0}" != "1" ]; then
    main "$@"
fi
