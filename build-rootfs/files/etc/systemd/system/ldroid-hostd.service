[Unit]
Description=LDroid guest -> Android host bridge (notify/forward)
After=ldroid-bootstrap.service
Wants=ldroid-bootstrap.service
Before=ldroid-ready.service

[Service]
Type=simple
ExecStart=/usr/local/bin/ldroid-hostd
Restart=on-failure
RestartSec=1
StandardOutput=append:/var/log/ldroid-hostd.log
StandardError=append:/var/log/ldroid-hostd.log

[Install]
WantedBy=multi-user.target
