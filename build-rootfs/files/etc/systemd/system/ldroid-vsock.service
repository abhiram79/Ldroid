[Unit]
Description=LDroid vsock control and port-forwarding agent (AVF only)
After=ldroid-bootstrap.service
Wants=ldroid-bootstrap.service
ConditionKernelCommandLine=ldroid.backend=avf
Before=ldroid-ready.service

[Service]
Type=simple
ExecStart=/usr/local/bin/ldroid-vsock-agent
Restart=on-failure
RestartSec=1
StandardOutput=append:/var/log/ldroid-vsock-agent.log
StandardError=append:/var/log/ldroid-vsock-agent.log

[Install]
WantedBy=multi-user.target
