#!/sbin/openrc-run
description="Ldroid guest -> Android host bridge (notify/forward)"
pidfile="/run/ldroid-hostd.pid"

depend() {
    need ldroid-bootstrap
    before ldroid-ready
}

start() {
    ebegin "Starting ldroid-hostd"
    start-stop-daemon --start --background \
        --make-pidfile --pidfile "$pidfile" \
        --stdout /var/log/ldroid-hostd.log \
        --stderr /var/log/ldroid-hostd.log \
        --exec /usr/local/bin/ldroid-hostd
    eend $?
}

stop() {
    if [ -f "$pidfile" ]; then
        ebegin "Stopping ldroid-hostd"
        start-stop-daemon --stop --pidfile "$pidfile"
        rm -f "$pidfile"
        eend $?
    fi
}
